# Optional. Absolute path to the shared application home used by the MCP
# server, the dashboard, and the control CLI.
#
# Leave it unset to use the default: %LOCALAPPDATA%\linkedin-mcp
#
# Must be absolute. A relative value is rejected on purpose: two MCP clients
# started from different working directories would otherwise open two different
# databases while appearing to share one configuration.
#
# Do not point this inside a cloned repository, and do not point it at a folder
# synchronised by OneDrive, Dropbox, or Google Drive — the live SQLite database
# uses WAL and must not be copied while open.
LINKEDIN_MCP_HOME=

# There is deliberately no variable here for a LinkedIn token, client id, or
# password. Credentials are never read from the environment and never placed in
# an AI-client configuration file. They are entered through the dashboard or
# `npm run control -- lane configure ...`, encrypted with a Windows
# DPAPI-wrapped key, and stored in the local database.
